---
import { t } from '../../i18n/utils';
import { Image } from 'astro:assets';
import heroVehiculos from '@/assets/heros/hero-vehiculos.webp';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
---

<div class="w-full px-0 md:px-12 mt-30">
  <section
    class="relative h-50 sm:h-64 md:h-96 rounded-[3rem] overflow-hidden flex items-end justify-start p-6 md:items-end md:justify-center md:pb-12"
  >
    <Image
      src={heroVehiculos}
      alt="Vehículos Costa Rica"
      class="absolute inset-0 w-full h-full object-cover object-[center_35%] md:object-[center_45%]"
      loading="eager"
      width={1920}
      height={1080}
      widths={[375,640,820,1024,1365,1600,1920]}
      format="webp"
      quality={95}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/20 to-black/35"></div>

    <div class="relative max-w-3xl mx-auto text-center z-10 px-4 sm:px-6">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight text-white mb-4 md:mb-5">
        {t(lang, 'vehicles.hero.title')}
      </h1>
    </div>
  </section>
</div>
