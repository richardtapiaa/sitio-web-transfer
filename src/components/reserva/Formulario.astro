---

import FormularioStepper from "./ReservaComponents/formulario/FormularioStepper.tsx";

import { Toaster } from 'sonner';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;

---

<section class="pt-20 md:pt-48 lg:pt-56 pb-12 md:pb-24 bg-transparent relative z-10">
  <div class="max-w-7xl mx-auto px-4">
    <Toaster position="bottom-center" richColors client:visible />
    <FormularioStepper client:visible lang={lang} />
  </div>
</section>
  