---
import { Image } from 'astro:assets';
import imgViaje from '@/assets/pasos/viaje.png';
import { t } from '../../../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
---
<section class="relative bg-transparent overflow-visible z-20">
  <!-- Background SVG -->
   
<div class="absolute top-0 right-0 w-full h-1/2 lg:w-4/5 lg:h-[150%] opacity-85 pointer-events-none">
  <svg viewBox="0 0 850 600" class="w-full h-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMaxYMid slice">
    <g transform="translate(850, 0) scale(1.1)">
      <path d="M0 459.7C-19.9 445.7 -39.7 431.8 -62 431.6C-84.4 431.4 -109.1 444.9 -129.5 441.1C-149.9 437.2 -165.8 415.9 -183.6 402.1C-201.4 388.2 -221 381.7 -239 371.8C-257 361.9 -273.4 348.6 -291.4 336.3C-309.4 324 -328.9 312.7 -340.8 295.3C-352.8 278 -357.1 254.7 -366.8 235.7C-376.4 216.7 -391.4 202 -404.8 184.9C-418.2 167.7 -430.1 148.3 -433.7 127.3C-437.3 106.4 -432.6 84.1 -435.5 62.6C-438.5 41.2 -449.1 20.6 -459.7 0L0 0Z" fill="#8BC34A"/>
    </g>
  </svg>
</div>



  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-24 relative z-10">
    <div class="grid lg:grid-cols-2 gap-20 lg:gap-32 items-center">

      <!-- Contenido a la izquierda (segundo en móvil) -->
      <div class="order-2 lg:order-1">

        <h3 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6 leading-tight">{t(lang, 'reserva.paso2.title')}</h3>

        <div class="mb-8">
          <p class="text-lg text-gray-600 max-w-xl leading-relaxed">
            {t(lang, 'reserva.paso2.desc')}
          </p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-6 mb-8 border border-gray-200">
          <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#8BC34A]" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
              <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
            </svg>
            {t(lang, 'reserva.paso2.infoTitle')}
          </h4>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start gap-3">
              <span class="text-[#8BC34A] font-bold mt-0.5">•</span>
              <span>{t(lang, 'reserva.paso2.item1')}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#8BC34A] font-bold mt-0.5">•</span>
              <span>{t(lang, 'reserva.paso2.item2')}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#8BC34A] font-bold mt-0.5">•</span>
              <span>{t(lang, 'reserva.paso2.item3')}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#8BC34A] font-bold mt-0.5">•</span>
              <span>{t(lang, 'reserva.paso2.item4')}</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Imagen a la derecha (primero en móvil) -->
        <div class="relative flex items-center justify-center h-[400px] lg:h-[500px] order-1 lg:order-2 lg:justify-end lg:pr-4 xl:pr-8 z-30 lg:z-10">
        <Image 
          src={imgViaje} 
          alt="Paso 2: Viaje" 
          class="w-full h-auto max-w-[280px] sm:max-w-sm lg:max-w-md" 
          loading="lazy" 
          width={800} 
          height={800} 
          widths={[400, 600, 800]} 
          format="avif" 
        />
      </div>

    </div>
  </div>
</section>
