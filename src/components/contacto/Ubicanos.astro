---
import { t } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
---

<section class="max-w-7xl mx-auto px-6 lg:px-8 py-22">
  <h2 class="text-3xl font-extrabold mb-6 text-center">{t(lang, 'contact.location.title')}</h2>

  <div class="aspect-video w-full rounded-lg overflow-hidden shadow-lg">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3935.6623319347505!2d-84.17011488897766!3d9.45097868220091!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa1739fb08cd44f%3A0xb8aa9aff7f4d499e!2sSouvenirs%20Los%20Amigos!5e0!3m2!1ses!2scr!4v1769573202365!5m2!1ses!2scr"
      width="600"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="w-full h-full"
    ></iframe>
  </div>
</section>
