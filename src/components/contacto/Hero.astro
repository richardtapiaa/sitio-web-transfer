---
import { t } from '../../i18n/utils';
import { Image } from 'astro:assets';
import heroReserva from '@/assets/heros/hero-reserva.webp';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
---


<div class="w-full px-0 md:px-12 mt-24 md:mt-28 lg:mt-32">
  <section
    class="relative h-[280px] sm:h-[320px] md:h-[400px] lg:h-[450px] rounded-none md:rounded-[3rem] overflow-hidden flex items-center justify-center shadow-2xl"
  >
    <!-- Background image as <img> for lazy-loading, sizes and better LCP handling -->
    <Image
      src={heroReserva}
      alt="Paisaje Costa Rica"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      width={1920}
      height={1080}
      widths={[375,640,820,1024,1365,1600,1920]}
      format="webp"
      quality={95}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/20 to-black/35"></div>

    <div class="relative max-w-3xl mx-auto text-center z-10 px-4 sm:px-6">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight text-white mb-4 md:mb-5">
        {t(lang, 'contact.hero.title')}
      </h1>


    </div>
  </section>
</div>


