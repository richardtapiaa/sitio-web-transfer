---
import '../styles/global.css';

import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';

import { ClientRouter } from 'astro:transitions';
import Loader from '@/components/common/Loader';


interface Props {
	title: string;
	description?: string;
	image?: string;
  lang?: string;
}

const { 
	title, 
	description = "Servicio de transporte privado en Quepos, Costa Rica. Traslados seguros y confiables.", 
	image = "/logo-eliud.png",
  lang = "es"
} = Astro.props;



const schema = {
	"@context": "https://schema.org",
	"@type": "TransportService",
	"name": "Transfer Eliud",
	"alternateName": "Transfer Eliud Costa Rica",
	"description": "Servicio de transporte privado y turístico en Quepos, Costa Rica. Flota moderna de buses y microbuses para tu seguridad y confort.",
	"logo": new URL("/logo-eliud.png", Astro.site).href,
	"image": new URL("/logo-eliud.png", Astro.site).href,
	"url": "https://transfer-eliud.com",
	"telephone": "+50684128671",
	"email": "info@transfer-eliud.com",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "Quepos",
		"addressLocality": "Quepos",
		"addressRegion": "Puntarenas",
		"postalCode": "60601",
		"addressCountry": "CR"
	},
	"areaServed": {
		"@type": "Country",
		"name": "Costa Rica"
	},
	"priceRange": "$$",
	"openingHoursSpecification": {
		"@type": "OpeningHoursSpecification",
		"dayOfWeek": [
			"Monday",
			"Tuesday",
			"Wednesday",
			"Thursday",
			"Friday",
			"Saturday",
			"Sunday"
		],
		"opens": "00:00",
		"closes": "23:59"
	},
	"sameAs": [
		"https://facebook.com/transfereliud",
		"https://instagram.com/transfereliud"
	]
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#8BC34A" />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="Transfer Eliud" />
		<meta name="language" content={lang} />
		<meta name="format-detection" content="telephone=yes" />
		<meta name="referrer" content="no-referrer-when-downgrade" />
		
		<!-- Favicons -->
		<link rel="icon" type="image/png" sizes="32x32" href="/logo-eliud.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/logo-eliud.png" />
		<link rel="shortcut icon" href="/logo-eliud.png" type="image/png" />
		<link rel="apple-touch-icon" href="/logo-eliud.png" />
		
		<!-- Preload critical fonts -->
		<link rel="preload" href="/node_modules/@fontsource/montserrat/files/montserrat-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/node_modules/@fontsource/montserrat/files/montserrat-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
		
		<!-- Dynamic SEO Props -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="transfer eliud, transporte costa rica, traslados costa rica, transfer costa rica, microbuses costa rica, buses privados, transporte privado costa rica, reservas transporte, transfer aeropuerto costa rica, traslados turísticos" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<!-- Hreflang for multilingual SEO -->
		<link rel="alternate" hreflang="es" href={new URL(Astro.url.pathname.replace('/en', '/es'), Astro.site)} />
		<link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname.replace('/es', '/en'), Astro.site)} />
		<link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace('/en', '/es'), Astro.site)} />

		<!-- Open Graph / Social -->
		<meta property="og:site_name" content="Transfer Eliud" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />
		<meta property="og:image" content={new URL(image, Astro.site)} />
		<meta property="og:image:secure_url" content={new URL(image, Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="Transfer Eliud - Transporte Privado en Costa Rica" />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@transfereliud" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site)} />
		<meta name="twitter:image:alt" content="Transfer Eliud - Transporte Privado en Costa Rica" />

		<ClientRouter />
		
	
		<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
		<link rel="dns-prefetch" href="https://fonts.googleapis.com">
		
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	
	<body>

  <Loader client:load />

  <slot />

  <script src="../components/scripts/scrollPreservation.js"></script>

</body>

</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		scroll-behavior: smooth;
		font-family: 'Montserrat', sans-serif;
		
	}
</style>
